# Required in Vercel Production, Preview and Development environments.
# Use a unique random value with at least 32 characters.
SESSION_SECRET=

# Google Identity Services Web Client ID.
# Example format: 1234567890-abcdef.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# Optional separate encryption key for saved prescriptions.
# When omitted, MedIndex derives a dedicated AES key from SESSION_SECRET.
MEDINDEX_USER_DATA_KEY=

# Optional emergency password fallback. Configure exactly one access verifier or leave both blank.
# Option A: a strong password stored as a protected Vercel Environment Variable.
ACCESS_CODE=

# Option B: a scrypt verifier instead of ACCESS_CODE.
# Format: scrypt:N:r:p:<hex-salt-at-least-32-chars>:<64-char-hex-hash>
ACCESS_CODE_SCRYPT=

# Optional comma-separated server-side admin email allowlist.
# Defaults to diellzarabushaj@gmail.com when omitted. Keep this aligned with
# private.admin_emails() in the Supabase migration before adding a co-admin.
MEDINDEX_ADMIN_EMAILS=diellzarabushaj@gmail.com

# Private shared secret used only by the Google Apps Script Drive → database sync trigger.
# Use a different random value with at least 32 characters; never place it in a Sheet cell.
MEDINDEX_DRIVE_SYNC_SECRET=

# Supabase is the only runtime database provider.
MEDINDEX_SUPABASE_URL=https://ftuchtmolddhhsdcwnqe.supabase.co
# Supabase publishable keys are safe for public/client use; RLS remains the security boundary.
MEDINDEX_SUPABASE_PUBLISHABLE_KEY=sb_publishable_HVz4u_h5jfcuejVWY44AsA_nk38rGa-
# SERVER ONLY. Prefer a Supabase sb_secret_* API key. Never commit the real value.
MEDINDEX_SUPABASE_SECRET_KEY=
# Legacy service_role JWT is also supported temporarily via MEDINDEX_SUPABASE_SERVICE_ROLE_KEY.
MEDINDEX_SUPABASE_SERVICE_ROLE_KEY=

# Optional AI configuration. Never reused for session signing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=high

# Optional clinical data configuration.
DOSAGE_SHEET_ID=
ENABLE_DOSAGE_AUTOFILL=FALSE
BLOB_READ_WRITE_TOKEN=
