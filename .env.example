# Required in Vercel Production, Preview and Development environments.
# Use a unique random value with at least 32 characters.
SESSION_SECRET=

# Configure exactly one access verifier.
# Option A: a strong password stored as a protected Vercel Environment Variable.
ACCESS_CODE=

# Option B: a scrypt verifier instead of ACCESS_CODE.
# Format: scrypt:N:r:p:<hex-salt-at-least-32-chars>:<64-char-hex-hash>
ACCESS_CODE_SCRYPT=

# Optional AI configuration. Never reused for session signing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=high

# Clinical data rollout.
# hybrid = Neon first + controlled Google fallback
# neon   = Neon only
# sheets = rollback to Google sources
MEDINDEX_DATA_SOURCE=hybrid
# Normally the audited project default is used; override only when moving the Neon Data API.
MEDINDEX_NEON_DATA_API_URL=

# Optional clinical data configuration.
DOSAGE_SHEET_ID=
ENABLE_DOSAGE_AUTOFILL=FALSE
BLOB_READ_WRITE_TOKEN=
