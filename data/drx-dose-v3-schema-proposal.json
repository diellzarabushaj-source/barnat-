{
  "schemaVersion": "drx-dose-v3-schema-proposal-v1",
  "updatedAt": "2026-08-29T12:18:34.858Z",
  "status": "proposal_hardened_not_applied",
  "principles": [
    "additive_only",
    "preserve_v2_until_cutover",
    "v3_self_contained_product_shell",
    "raw_source_immutable_by_sha256",
    "source_snapshot_equals_evidence_hash",
    "source_version_or_date_required",
    "publication_fail_closed",
    "runtime_schema_enum_parity",
    "combination_basis_explicit",
    "renal_measure_no_inference",
    "hepatic_measure_no_inference",
    "review_decisions_auditable",
    "one_rpc_product_fast_path",
    "Published rule provenance pins the exact SmPC section hash and is revalidated at runtime.",
    "Renal/hepatic runtime adjustments are exposed only when review_status=verified, parent rule is published, and exact SmPC 4.2 hash provenance revalidates."
  ],
  "tables": [
