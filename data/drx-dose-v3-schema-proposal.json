        "final_url": "text",
        "source_tier": "text",
        "authority": "text",
        "document_version": "text",
        "document_date": "date",
        "fetched_at": "timestamptz",
        "raw_sha256": "sha256 text unique",
        "archive_locator": "text"
      }
    },
