{
  "schemaVersion": "drx-dose-v3-schema-proposal-v1",
  "updatedAt": "2026-08-29",
  "status": "proposal_only_not_applied",
  "principles": [
    "additive_only",
    "preserve_v2",
    "raw_source_immutable_by_hash",
    "publication_fail_closed",
    "authored_rules_require_source_evidence",
    "combination_basis_explicit",
    "review_decisions_auditable"
  ],
  "tables": [
    {
      "name": "dose_source_snapshots_v3",
      "purpose": "Immutable archive metadata for authoritative source snapshots.",
      "primaryKey": [
        "snapshot_id"
      ],
      "columns": {
        "snapshot_id": "text sha256 hex",
        "source_key": "text not null",
        "source_url": "text not null",
        "final_url": "text not null",
        "source_tier": "text not null",
        "authority": "text not null",
        "jurisdiction": "text",
        "document_type": "text",
        "document_version": "text",
        "document_date": "date",
        "fetched_at": "timestamptz not null",
        "content_type": "text",
        "content_length": "bigint",
        "raw_sha256": "text not null unique",
        "etag": "text",
        "last_modified": "text",
        "parser_version": "text",
        "archive_locator": "text",
        "created_at": "timestamptz not null default now()"
      },
      "exposure": "service_only",
      "rls": true
    },
    {
      "name": "dose_source_sections_v3",
      "purpose": "Structured §4.x extraction with provenance anchored to one immutable snapshot.",
      "primaryKey": [
        "snapshot_id",
        "section_code"
      ],
      "foreignKeys": {
        "snapshot_id": "dose_source_snapshots_v3.snapshot_id"
      },
      "columns": {
        "snapshot_id": "text not null",
        "section_code": "text not null",
        "section_key": "text not null",
        "heading": "text",
        "section_text": "text not null",
        "section_sha256": "text not null",
        "extracted_json": "jsonb not null default '{}'",
        "parser_version": "text not null",
        "extraction_status": "text not null",
        "created_at": "timestamptz not null default now()"
      },
      "exposure": "service_only",
      "rls": true
    },
    {
      "name": "dose_indication_concepts_v3",
      "purpose": "Canonical indication identity separate from source wording.",
      "primaryKey": [
        "indication_id"
      ],
      "columns": {
        "indication_id": "uuid",
        "indication_key": "text not null unique",
        "canonical_name": "text not null",
        "icd10_codes": "text[] not null default '{}'",
        "icd_verification_status": "text not null",
        "editorial_status": "text not null",
        "created_at": "timestamptz not null default now()",
        "updated_at": "timestamptz not null default now()"
      },
      "exposure": "published_read_only",
      "rls": true
    },
    {
      "name": "dose_indication_terms_v3",
      "purpose": "Exact reviewed aliases from source documents.",
      "primaryKey": [
        "term_key"
      ],
      "foreignKeys": {
        "indication_id": "dose_indication_concepts_v3.indication_id"
      },
      "columns": {
        "term_key": "text",
        "indication_id": "uuid not null",
        "term": "text not null",
        "language": "text",
        "term_type": "text not null",
        "source_snapshot_id": "text",
        "verified_at": "timestamptz",
        "created_at": "timestamptz not null default now()"
      },
      "exposure": "service_only",
      "rls": true
    },
    {
      "name": "dose_rules_v3",
      "purpose": "Normalized deterministic dose rules with immutable source evidence.",
      "primaryKey": [
        "rule_id"
      ],
      "columns": {
        "rule_id": "uuid",
        "rule_key": "text not null unique",
        "substance_concept_id": "uuid not null",
        "indication_id": "uuid not null",
        "patient_group": "text not null",
        "calculation_method": "text not null",
        "dose_min_value": "numeric",
        "dose_max_value": "numeric",
        "dose_unit": "text",
        "dose_basis": "text",
        "weight_basis": "text",
        "frequency_mode": "text not null",
        "interval_min_hours": "numeric",
        "interval_max_hours": "numeric",
        "times_per_day": "numeric",
        "times_per_day_min": "numeric",
        "times_per_day_max": "numeric",
        "max_single_dose_mg": "numeric",
        "max_daily_dose_mg": "numeric",
        "max_doses_24h": "numeric",
        "duration_mode": "text not null",
        "duration_min_days": "numeric",
        "duration_max_days": "numeric",
        "review_after_days": "numeric",
        "min_age_months": "numeric",
        "max_age_months": "numeric",
        "min_weight_kg": "numeric",
        "max_weight_kg": "numeric",
        "route": "text",
        "pharmaceutical_form": "text",
        "prn": "boolean not null default false",
        "renal_adjustment_required": "boolean not null default false",
        "hepatic_adjustment_required": "boolean not null default false",
        "cardiac_adjustment_required": "boolean not null default false",
        "specialist_only": "boolean not null default false",
        "out_of_range_action": "text not null default 'block'",
        "required_inputs": "text[] not null default '{}'",
        "dose_basis_mode": "text not null default 'single_active'",
        "dose_basis_component_concept_id": "uuid",
        "source_key": "text not null",
        "source_snapshot_id": "text not null",
        "source_section": "text not null default '4.2'",
        "source_evidence_hash": "text not null",
        "confidence_score": "numeric",
        "review_class": "text",
        "editorial_status": "text not null default 'draft'",
        "verified_by": "text",
        "verified_at": "timestamptz",
        "version_no": "integer not null default 1",
        "created_at": "timestamptz not null default now()",
        "updated_at": "timestamptz not null default now()"
      },
      "exposure": "published_read_only",
      "rls": true
    },
    {
      "name": "dose_rule_products_v3",
      "purpose": "Exact product bindings between sourced rules and DRx registry products.",
      "primaryKey": [
        "binding_id"
      ],
      "columns": {
        "binding_id": "uuid",
        "rule_id": "uuid not null",
        "drug_id": "uuid not null",
        "product_key": "text",
        "match_method": "text not null",
        "preferred": "boolean not null default false",
        "conversion_enabled": "boolean not null default false",
        "tablet_split_allowed": "boolean not null default false",
        "rounding_increment_value": "numeric",
        "rounding_increment_unit": "text",
        "binding_status": "text not null",
        "verified_at": "timestamptz",
        "created_at": "timestamptz not null default now()"
      },
      "exposure": "published_read_only",
      "rls": true
    },
    {
      "name": "dose_legacy_comparisons_v3",
      "purpose": "Auditable exact/conflict/missing comparison against legacy dosage_regimens.",
      "primaryKey": [
        "comparison_id"
      ],
      "columns": {
        "comparison_id": "uuid",
        "rule_id": "uuid not null",
        "drug_id": "uuid",
        "legacy_regimen_id": "uuid",
        "comparison_status": "text not null",
        "conflicts": "jsonb not null default '[]'",
        "missing_fields": "text[] not null default '{}'",
        "compared_at": "timestamptz not null default now()"
      },
      "exposure": "service_only",
      "rls": true
    },
    {
      "name": "dose_review_queue_v3",
      "purpose": "Conflict/high-risk/manual-review work queue.",
      "primaryKey": [
        "review_id"
      ],
      "columns": {
        "review_id": "uuid",
        "rule_id": "uuid not null",
        "drug_id": "uuid",
        "priority": "integer not null",
        "review_reason_codes": "text[] not null",
        "review_status": "text not null default 'open'",
        "assigned_to": "uuid",
        "decision": "text",
        "decision_notes": "text",
        "opened_at": "timestamptz not null default now()",
        "decided_at": "timestamptz"
      },
      "exposure": "admin_only",
      "rls": true
    },
    {
      "name": "dose_publication_events_v3",
      "purpose": "Immutable audit log for every publication decision.",
      "primaryKey": [
        "event_id"
      ],
      "columns": {
        "event_id": "uuid",
        "rule_id": "uuid not null",
        "drug_id": "uuid",
        "from_status": "text",
        "to_status": "text not null",
        "gate_version": "text not null",
        "gate_result": "jsonb not null",
        "actor_user_id": "uuid",
        "created_at": "timestamptz not null default now()"
      },
      "exposure": "service_only",
      "rls": true
    }
  ],
  "compatibility": {
    "v2RuntimeUnchangedUntilCutover": true,
    "initialWriteMode": "v3_shadow_only",
    "publicationCutoverRequires": [
      "batch1_10_substances_reviewed",
      "legacy_comparison_complete_for_bound_products",
      "zero_fail_closed_gate_violations",
      "api_parity_verified",
      "rollback_tested"
    ]
  }
}
