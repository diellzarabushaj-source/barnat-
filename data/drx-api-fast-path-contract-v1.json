{
  "schemaVersion": "drx-api-fast-path-contract-v1",
  "status": "v3_one_rpc_adjustment_provenance_hardened_repository_not_live",
  "request": {
    "endpoint": "/api/dosage?view=product-rules",
    "selectorRule": "exactly_one_selector",
    "supportedSelectors": [
      "productKey",
      "drugId",
      "registryNumber_v2_compatibility_only"
    ],
    "preferredV3Selectors": [
      "productKey",
      "drugId"
    ],
    "patientInputs": "not_sent_to_catalog_fast_path; calculation uses shared dose-core client/server adapters after rule retrieval"
  },
  "response": {
    "required": [
      "schemaVersion",
      "product",
      "meta"
    ],
    "productRequired": [
      "productKey",
      "rules"
    ],
    "metaRequired": [
      "failClosed",
      "publishedOnly",
      "officialVerifiedOnly",
      "runtimeModel"
    ],
    "etag": "HTTP ETag on authenticated product-scoped response",
    "maxPayloadIntent": "tiny_product_scoped_payload",
    "ruleRequired": [
      "source.snapshotId",
      "source.section=4.2",
      "source.sectionSha256",
      "source.evidenceHash",
      "source.documentVersion_or_documentDate",
      "source.official=true",
      "renalAdjustments[] when renalAdjustmentRequired=true",
      "hepaticAdjustments[] when hepaticAdjustmentRequired=true"
    ]
  },
  "guarantees": [
    "product_scoped_only",
    "published_rules_only",
    "deterministic_order",
    "no_legacy_bulk_payload",
    "one_http_request_per_product",
    "v3_one_db_rpc_target",
    "hash_backed_source_only_in_v3",
    "source_version_or_date_required_in_v3_rpc",
    "exact_smpc_4_2_hash_required_in_v3_rpc",
    "snapshot_equals_evidence_hash",
    "nested_adjustment_provenance_validated",
    "required_adjustment_array_must_be_nonempty",
    "runtime_payload_revalidated_client_side"
  ],
  "failClosedOn": [
    "unknown_product",
    "unpublished_rule",
    "missing_required_input",
    "conflicting_verified_rules",
    "source_provenance_mismatch",
    "missing_smpc_4_2_hash",
    "renal_adjustment_required_but_unavailable",
    "hepatic_adjustment_required_but_unavailable",
    "invalid_nested_adjustment_provenance"
  ],
  "next": "after V3 live apply: structural+transactional smoke, benchmark one-RPC payload including verified adjustments, enable reads then RPC strict then V3 strict only after parity",
  "v3": {
    "rpc": "public.medindex_dose_product_fast_path_v3",
    "targetDbReads": 1,
    "rolloutFallback": "v3 multi-read only while RPC is absent and DRX_DOSE_V3_RPC_STRICT is disabled",
    "strictFlag": "DRX_DOSE_V3_RPC_STRICT",
    "readFlag": "DRX_DOSE_V3_READS",
    "cutoverFlag": "DRX_DOSE_V3_STRICT"
  }
}
