{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": ".",
  "env": {
    "GOOGLE_CLIENT_ID": "352548189224-fs7j23nquvnj9bm0fda2qnfhpureib0j.apps.googleusercontent.com",
    "PRESCRIPTION_SHEET_ID": "1o-TT-Oqlsw4aUo5DW3XZT6T9eD_IeEBCFQyjBSYM4-Q",
    "PRESCRIPTION_SHEET_GID": "407106508"
  },
  "rewrites": [
    { "source": "/data/registry-data.js", "destination": "/api/registry" },
    { "source": "/api/gemini-prescription", "destination": "/api/gemini-prescription-secure" },
    { "source": "/api/user-library", "destination": "/api/auth?scope=library" },
    { "source": "/api/population-verification", "destination": "/api/clinical-editor?populationVerification=1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=(), identity-credentials-get=(self)" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "Origin-Agent-Cluster", "value": "?1" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; frame-src https://accounts.google.com/gsi/; form-action 'self'; object-src 'none'; script-src 'self' https://accounts.google.com/gsi/client; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data:; connect-src 'self' https://accounts.google.com/gsi/; font-src 'self' data:; media-src 'self'; worker-src 'self'; manifest-src 'self'; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "Vary", "value": "Cookie, Origin" }
      ]
    },
    {
      "source": "/data/registry-data.js",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "Vary", "value": "Cookie" }
      ]
    },
    {
      "source": "/data/protocols.json",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-cache, max-age=0" },
        { "key": "Vary", "value": "Cookie" }
      ]
    },
    {
      "source": "/login.html",
      "headers": [{ "key": "Cache-Control", "value": "private, no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/recovery.html",
      "headers": [{ "key": "Cache-Control", "value": "private, no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "private, no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [{ "key": "Cache-Control", "value": "private, no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(.*)\\.(svg|png|jpg|jpeg|webp|ico)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.(json|txt)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=31536000, stale-while-revalidate=604800" }]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/recovery.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/sw-resilient.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/sw-resilient-v3.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ]
}
