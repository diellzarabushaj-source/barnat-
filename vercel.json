{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": ".",
  "functions": {
    "api/drug-search.js": {
      "regions": ["lhr1"]
    },
    "api/icd.js": {
      "includeFiles": "data/icd-hierarchy-snapshot.json.gz"
    }
  },
  "env": {
    "GOOGLE_CLIENT_ID": "352548189224-fs7j23nquvnj9bm0fda2qnfhpureib0j.apps.googleusercontent.com",
    "PRESCRIPTION_SHEET_ID": "1o-TT-Oqlsw4aUo5DW3XZT6T9eD_IeEBCFQyjBSYM4-Q",
    "PRESCRIPTION_SHEET_GID": "407106508",
    "MEDINDEX_DATA_SOURCE": "sheets",
    "DOSAGE_SHEET_ID": "17cuXg5qORIIWkvAxLZ7uz2FMmGvzwjr850cubUcIgLE"
  },
  "redirects": [
    {
      "source": "/klasifikimi",
      "destination": "/index.html",
      "permanent": false
    },
    {
      "source": "/klasifikimi.html",
      "destination": "/index.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/data/registry-data.js",
      "destination": "/api/registry"
    },
    {
      "source": "/api/dose-calculator",
      "destination": "/api/dosage?view=calculator"
    },
    {
      "source": "/api/pediatric-only-population",
      "destination": "/api/dosage?view=approved-population"
    },
    {
      "source": "/api/dosage/search",
      "destination": "/api/dosage?view=pediatric-search"
    },
    {
      "source": "/api/dosage/product/:drugId",
      "destination": "/api/dosage?view=pediatric-product&drugId=:drugId"
    },
    {
      "source": "/api/dosage/calculate",
      "destination": "/api/dosage?view=pediatric-calculate"
    },
    {
      "source": "/api/atc-counts",
      "destination": "/api/drug-search?view=atc-counts"
    },
    {
      "source": "/api/gemini-prescription",
      "destination": "/api/gemini-prescription-secure"
    },
    {
      "source": "/api/user-library",
      "destination": "/api/auth?scope=library"
    },
    {
      "source": "/api/population-verification",
      "destination": "/api/clinical-editor?populationVerification=1"
    },
    {
      "source": "/api/media",
      "destination": "/api/clinical-editor?mediaLibrary=1"
    },
    {
      "source": "/brand/medindex-mark-on-light.webp",
      "destination": "/api/clinical-editor?officialBrand=markOnLight"
    },
    {
      "source": "/brand/medindex-full-on-dark.png",
      "destination": "/api/clinical-editor?officialBrand=fullOnDark"
    },
    {
      "source": "/brand/medindex-mark-on-dark.png",
      "destination": "/api/clinical-editor?officialBrand=markOnDark"
    },
    {
      "source": "/brand/medindex-full-on-light.png",
      "destination": "/api/clinical-editor?officialBrand=fullOnLight"
    },
    {
      "source": "/brand/medindex-horizontal-on-light.webp",
      "destination": "/api/clinical-editor?officialBrand=horizontalOnLight"
    },
    {
      "source": "/brand/medindex-horizontal-on-dark.webp",
      "destination": "/api/clinical-editor?officialBrand=horizontalOnDark"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/regjistrimi",
      "destination": "/regjistrimi.html"
    },
    {
      "source": "/admin-login",
      "destination": "/admin-login.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=(), identity-credentials-get=(self)"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "Origin-Agent-Cluster",
          "value": "?1"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; frame-src https://accounts.google.com/gsi/; form-action 'self'; object-src 'none'; script-src 'self' https://accounts.google.com/gsi/client; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: https://*.public.blob.vercel-storage.com https://cdn.sanity.io https://images.unsplash.com; connect-src 'self' https://accounts.google.com/gsi/ https://4wdtp8cz.apicdn.sanity.io https://4wdtp8cz.api.sanity.io; font-src 'self' data:; media-src 'self'; worker-src 'self'; manifest-src 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "Vary",
          "value": "Cookie, Origin"
        }
      ]
    },
    {
      "source": "/data/registry-data.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "Vary",
          "value": "Cookie"
        }
      ]
    },
    {
      "source": "/data/protocols.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-cache, max-age=0"
        },
        {
          "key": "Vary",
          "value": "Cookie"
        }
      ]
    },
    {
      "source": "/login.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/login-v2.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/recovery.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(svg|png|jpg|jpeg|webp|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(json|txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=31536000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/recovery.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/sw-resilient.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/sw-resilient-v3.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}
